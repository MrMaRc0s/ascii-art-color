package main

import (
	"strings"
)

// ANSI color codes
var ansiColors = map[string]string{
	"red":     "\033[31m",
	"green":   "\033[32m",
	"yellow":  "\033[33m",
	"blue":    "\033[34m",
	"magenta": "\033[35m",
	"cyan":    "\033[36m",
	"reset":   "\033[0m",
}

// Function to convert color name to ANSI escape code (or another color format)
func convertColorNameToCode(colorName string) string {
	if colorCode, exists := ansiColors[colorName]; exists {
		return colorCode
	}
	return ""
}

// Function to apply color to the ASCII art based on substring presence
func applyColor(line, color, substring string) string {
	if substring == "" {
		return ansiColors[color] + line + ansiColors["reset"]
	}
	// Only color the part of the line that matches the substring
	coloredLine := strings.Replace(line, substring, ansiColors[color]+substring+ansiColors["reset"], 1)
	return coloredLine
}
