package main

import "strings"

// ANSI color codes
var colorCodes = map[string]string{
	"red":     "\033[31m",
	"green":   "\033[32m",
	"yellow":  "\033[33m",
	"blue":    "\033[34m",
	"magenta": "\033[35m",
	"cyan":    "\033[36m",
	"reset":   "\033[0m",
}

// / New coloring function
func applyColor(line, color, substring string) string {
	if color == "" {
		return line
	}
	// Color only the specified substring if provided
	if substring != "" {
		coloredSubstring := colorCodes[color] + substring + colorCodes["reset"]
		return strings.ReplaceAll(line, substring, coloredSubstring)
	}
	// If no substring is specified, color the entire line
	return colorCodes[color] + line + colorCodes["reset"]
}
