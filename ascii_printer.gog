package main

import (
	"fmt"
	"strings"
)

// PrintAsciiArtRecursive: Updated to handle substring coloring
func PrintAsciiArtRecursive(sentences []string, textFile []string, color string, substring string) {
	// Base case: If no sentences left, return
	if len(sentences) == 0 {
		return
	}

	// Process the first sentence
	if sentences[0] != "" {
		printSentenceAsciiRecursive(sentences[0], textFile, 1, color, substring)
		fmt.Print()
	} else {
		// If the sentence is empty (i.e., there was a '\n'), print an empty line
		fmt.Println()
	}

	// Recursive call to process the remaining sentences
	PrintAsciiArtRecursive(sentences[1:], textFile, color, substring)
}

func printSentenceAsciiRecursive(word string, textFile []string, h int, color string, substring string) {
	// Base case: If we've processed all the lines for this character height, return
	if h > 8 {
		return
	}

	// Print the current line for each character in the word
	for i := 0; i < len(word); i++ {
		for lineIndex, line := range textFile {
			if lineIndex == (int(word[i])-32)*9+h {
				// Color the lines that correspond to the current character if it is part of the substring
				if substring != "" && strings.Contains(word[i:], substring) {
					// Highlight only the substring part in the line
					coloredLine := applyColor(line, color, word[i:i+len(substring)])
					fmt.Print(coloredLine)
					i += len(substring) - 1 // Move the index past the substring
				} else if substring == "" {
					// If no substring is specified, color the whole word
					coloredLine := applyColor(line, color, "")
					fmt.Print(coloredLine)
				} else {
					// Print the lines normally for characters outside the substring
					fmt.Print(line)
				}
			}
		}
	}
	fmt.Println()
	// Recursive call for the next line height
	printSentenceAsciiRecursive(word, textFile, h+1, color, substring)
}
